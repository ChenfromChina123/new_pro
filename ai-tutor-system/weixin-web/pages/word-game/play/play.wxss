/* pages/word-game/index.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
  box-sizing: border-box;
  padding: 0;
}

.start-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  border-radius: 30rpx;
  padding: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.05);
  margin: 40rpx;
}

.title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.game-title {
  font-size: 64rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
  animation: bounceIn 0.8s ease-out;
}

.game-desc {
  font-size: 32rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  animation: fadeIn 1s ease-out 0.3s both;
}

.start-btn {
  width: 80% !important;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  background-color: #20c997 !important;
  color: #fff;
  margin-top: 40rpx;
  font-weight: bold;
  animation: pulse 2s infinite;
}

.game-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #fafafa;
}

.top-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  animation: slideInDown 0.5s ease-out;
}

.nav-btn {
  background-color: #f0f0f0;
  color: #333;
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  border-radius: 12rpx;
  font-weight: 500;
  z-index: 20;
  position: relative;
  transition: all 0.3s;
}

.nav-btn:active {
  transform: scale(0.95);
}

.progress-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  animation: slideInLeft 0.5s ease-out;
}

.progress-badge {
  background-color: #f0f0f0;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  animation: scaleIn 0.5s ease-out 0.2s both;
}

.progress-badge .total {
  color: #ccc;
}

.word-card-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.word-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  animation: float 3s ease-in-out infinite;
}

.word-mean {
  font-size: 64rpx;
  font-weight: 800;
  color: #1a202c;
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.phonetic {
  font-size: 32rpx;
  color: #adb5bd;
  letter-spacing: 2rpx;
}

.blanks-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 20rpx;
}

.blank-space {
  width: 20rpx;
  height: 80rpx;
}

.blank-item {
  min-width: 60rpx;
  padding: 0 10rpx;
  height: 80rpx;
  border-bottom: 4rpx solid #dee2e6;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  transition: all 0.3s;
  letter-spacing: 4rpx;
  animation: slideInUp 0.5s ease-out both;
  animation-fill-mode: both;
}

.blank-item.filled {
  color: #1296db;
  animation: bounceIn 0.4s ease-out;
  border-bottom-color: #1296db;
}

.blank-item.active {
  border-bottom-color: #1296db;
  transform: scale(1.1);
}

.overlay-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  color: transparent;
  z-index: 10;
  pointer-events: auto;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

/* 自定义 Toast 样式 */
.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  pointer-events: none;
}

.toast-box {
  background-color: #fff;
  padding: 40rpx 60rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.1);
  animation: fadeIn 0.3s ease-out forwards;
}

.toast-box.success {
  border: 4rpx solid #20c997;
}

.toast-box.success .toast-text {
  color: #20c997;
  animation: bounceIn 0.5s ease-out;
}

.toast-box.error {
  border: 4rpx solid #ff4d4f;
  animation: shake 0.4s ease-in-out forwards;
}

.toast-box.error .toast-text {
  color: #ff4d4f;
}

.toast-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 20rpx;
}

@keyframes fadeIn {
  0% { opacity: 0; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes bounceIn {
  0% { opacity: 0; transform: scale(0.3); }
  50% { opacity: 1; transform: scale(1.05); }
  70% { transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes scaleIn {
  0% { opacity: 0; transform: scale(0); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes slideInUp {
  0% { opacity: 0; transform: translateY(40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes slideInDown {
  0% { opacity: 0; transform: translateY(-40rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
  0% { opacity: 0; transform: translateX(-40rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  50% { transform: translateX(10rpx); }
  75% { transform: translateX(-10rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.modal {
  background-color: #fff;
  width: 80%;
  padding: 60rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: bounceIn 0.5s ease-out;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.final-score {
  font-size: 60rpx;
  color: #1296db;
  margin-bottom: 60rpx;
  animation: bounceIn 0.6s ease-out 0.2s both;
}

.modal-footer {
  width: 100%;
}

.retry-btn {
  margin-bottom: 20rpx;
}

.home-btn {
  background-color: #f5f5f5 !important;
  color: #666 !important;
}
