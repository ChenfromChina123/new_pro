/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f0f2f5;
  padding: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #999;
}

.chat-list {
  flex: 1;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

.chat-bottom-padding {
  height: 40rpx;
}

.message-item {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar-wrapper {
  margin: 0 20rpx;
  flex-shrink: 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}

.content-wrapper {
  max-width: 70%;
}

.message-content {
  padding: 24rpx 30rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.user .message-content {
  background-color: #1296db;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.assistant .message-content {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

.loading-content {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #999;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.input-area {
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #eaeaea;
  align-items: flex-end;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.03);
}

.input {
  flex: 1;
  background-color: #f5f6f8;
  border-radius: 36rpx;
  padding: 20rpx 30rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
  min-height: 40rpx;
  max-height: 200rpx;
  line-height: 1.4;
}

.send-btn-wrapper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #1296db;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  box-shadow: 0 4rpx 8rpx rgba(18, 150, 219, 0.3);
}

.send-btn.disabled {
  background-color: #ccc;
  box-shadow: none;
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
}
