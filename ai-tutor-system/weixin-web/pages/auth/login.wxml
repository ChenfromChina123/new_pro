<!--pages/auth/login.wxml-->
<view class="container">
  <view class="login-header">
    <image class="logo" src="/assets/logo.png"></image>
    <text class="title">AI Study Tutor</text>
  </view>
  
  <view class="login-form">
    <view class="form-item">
      <input class="input" placeholder="请输入手机号/邮箱" bindinput="handleInput" data-type="username" value="{{username}}" />
    </view>
    <view class="form-item">
      <input class="input" placeholder="请输入密码" password bindinput="handleInput" data-type="password" value="{{password}}" />
    </view>
    
    <button class="login-btn" type="primary" bindtap="handleLogin" loading="{{loading}}">登录</button>
    
    <view class="login-footer">
      <text class="link" bindtap="goToRegister">还没有账号？去注册</text>
      <text class="link">忘记密码</text>
    </view>
  </view>
</view>
