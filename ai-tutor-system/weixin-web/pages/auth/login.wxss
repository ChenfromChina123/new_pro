/* pages/auth/login.wxss */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f8f8f8;
}

.login-header {
  margin-bottom: 80rpx;
  text-align: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.login-form {
  width: 100%;
}

.form-item {
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
}

.input {
  height: 80rpx;
  font-size: 30rpx;
}

.login-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  margin-top: 50rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
}

.login-footer {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  width: 100%;
  font-size: 26rpx;
  color: #666;
}

.link {
  padding: 10rpx;
}
