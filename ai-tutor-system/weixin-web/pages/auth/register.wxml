<!--pages/auth/register.wxml-->
<view class="container">
  <view class="login-header">
    <text class="title">创建账号</text>
  </view>
  
  <view class="login-form">
    <view class="form-item">
      <input class="input" placeholder="请输入手机号/邮箱" bindinput="handleInput" data-type="username" value="{{username}}" />
    </view>
    <view class="form-item">
      <view class="code-wrapper">
        <input class="input" placeholder="请输入验证码" bindinput="handleInput" data-type="code" value="{{code}}" />
        <button class="code-btn" bindtap="sendCode" disabled="{{codeLoading ? true : (countdown > 0)}}">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>
    <view class="form-item">
      <input class="input" placeholder="请输入密码" password bindinput="handleInput" data-type="password" value="{{password}}" />
    </view>
    <view class="form-item">
      <input class="input" placeholder="确认密码" password bindinput="handleInput" data-type="confirmPassword" value="{{confirmPassword}}" />
    </view>
    
    <button class="login-btn" type="primary" bindtap="handleRegister" loading="{{loading}}">注册</button>
    
    <view class="login-footer">
      <text class="link" bindtap="goToLogin">已有账号？去登录</text>
    </view>
  </view>
</view>
