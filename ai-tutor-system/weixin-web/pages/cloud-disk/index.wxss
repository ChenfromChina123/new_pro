/* pages/cloud-disk/index.wxss */
.disk-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
  padding: 0;
}

.header-actions {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f6f8;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 30rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 10rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e6f7ff;
  color: #1296db;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.plus-icon {
  font-size: 36rpx;
  margin-right: 6rpx;
  margin-top: -4rpx;
}

.breadcrumb {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eaeaea;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.02);
  z-index: 10;
}

.path-scroll {
  white-space: nowrap;
  width: 100%;
}

.path-item {
  display: inline-block;
  font-size: 28rpx;
  color: #666;
}

.path-item .active {
  color: #333;
  font-weight: bold;
}

.separator {
  display: inline-block;
  margin: 0 10rpx;
  color: #ccc;
  font-size: 24rpx;
}

.file-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.upload-btn-empty {
  background-color: #1296db;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.list-group {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  padding: 10rpx 0;
}

.group-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 30rpx 10rpx;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s;
}

.file-item:active {
  background-color: #f9f9f9;
}

.file-item:last-child {
  border-bottom: none;
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.file-name {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-meta {
  font-size: 24rpx;
  color: #999;
}

.more-action {
  padding: 20rpx;
  margin: -20rpx -20rpx -20rpx 0;
}

.dot-icon {
  font-size: 36rpx;
  color: #999;
  line-height: 1;
  letter-spacing: 2rpx;
}