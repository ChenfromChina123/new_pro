/* pages/ai-article/index.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f8f9fa;
  padding: 0;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background-color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.generate-btn {
  margin: 0 !important;
  background-color: #1296db !important;
  border-radius: 30rpx;
}

.filter-bar {
  padding: 20rpx 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eaeaea;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  height: 70rpx;
  border-radius: 35rpx;
  padding: 0 30rpx;
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  font-size: 28rpx;
}

.article-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-state text {
  color: #999;
  margin-bottom: 40rpx;
}

.action-btn {
  background-color: #1296db;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  width: 240rpx;
}

.article-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.article-info {
  flex: 1;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.article-tags {
  display: flex;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.lang-tag {
  color: #1296db;
  background-color: #e6f7ff;
}

.article-date {
  font-size: 24rpx;
  color: #999;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
  font-weight: bold;
}

.loading-tips {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}