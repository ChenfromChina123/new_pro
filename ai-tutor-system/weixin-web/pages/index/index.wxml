<!--index.wxml-->
<scroll-view scroll-y class="page-bg" style="height: 100vh;">
  <view class="container">
    <!-- 欢迎区域 - 淡入动画 -->
    <view class="welcome-section animate-fade-in">
      <text class="greeting animate-slide-in-up">你好，{{userInfo.username ? userInfo.username : '同学'}}！</text>
      <text class="subtitle animate-slide-in-up" style="animation-delay: 0.1s">今天想学点什么？</text>
    </view>

    <!-- 功能网格 - 滑入动画 -->
    <view class="feature-grid">
      <view class="feature-item animate-scale-in clickable" bindtap="goToChat" style="animation-delay: 0.2s">
        <view class="icon-wrapper ai-bg hover-lift">
          <image class="feature-icon" src="/assets/ai-icon.png"></image>
        </view>
        <text class="feature-name">AI 智能辅导</text>
        <text class="feature-desc">随时随地的学习助手</text>
      </view>

      <view class="feature-item animate-scale-in clickable" bindtap="goToWordGame" style="animation-delay: 0.3s">
        <view class="icon-wrapper word-bg hover-lift">
          <image class="feature-icon" src="/assets/word-icon.png"></image>
        </view>
        <text class="feature-name">单词挑战</text>
        <text class="feature-desc">趣味记忆，攻克难词</text>
      </view>

      <view class="feature-item animate-scale-in clickable" bindtap="goToCloudDisk" style="animation-delay: 0.4s">
        <view class="icon-wrapper disk-bg hover-lift">
          <image class="feature-icon" src="/assets/disk-icon.png"></image>
        </view>
        <text class="feature-name">我的网盘</text>
        <text class="feature-desc">学习资料，随身带走</text>
      </view>

      <view class="feature-item animate-scale-in clickable" bindtap="goToAiArticle" style="animation-delay: 0.5s">
        <view class="icon-wrapper article-bg hover-lift">
          <image class="feature-icon" src="/assets/document-icon.png"></image>
        </view>
        <text class="feature-name">AI 文章</text>
        <text class="feature-desc">智能生成阅读材料</text>
      </view>

      <view class="feature-item animate-scale-in clickable" bindtap="goToProfile" style="animation-delay: 0.6s">
        <view class="icon-wrapper user-bg hover-lift">
          <image class="feature-icon" src="/assets/user-icon.png"></image>
        </view>
        <text class="feature-name">个人中心</text>
        <text class="feature-desc">管理你的学习进度</text>
      </view>
    </view>

    <!-- 统计区域 - 弹跳进入 -->
    <view class="stats-section animate-bounce-in" style="animation-delay: 0.7s">
      <text class="section-title">学习统计</text>
      <view class="stats-card">
        <view class="stat-item animate-float" style="animation-delay: 0s">
          <text class="stat-value">0</text>
          <text class="stat-label">已学单词</text>
        </view>
        <view class="stat-item animate-float" style="animation-delay: 0.2s">
          <text class="stat-value">0</text>
          <text class="stat-label">对话次数</text>
        </view>
        <view class="stat-item animate-float" style="animation-delay: 0.4s">
          <text class="stat-value">0</text>
          <text class="stat-label">连续打卡</text>
        </view>
      </view>
    </view>
    
    <!-- 底部留白，防止被 TabBar 或安全区遮挡 -->
    <view style="height: 60rpx;"></view>
  </view>
</scroll-view>
