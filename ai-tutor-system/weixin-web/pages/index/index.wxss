/** index.wxss **/
.page-bg {
  background-color: var(--bg-primary);
  min-height: 100vh;
  transition: background-color 0.3s ease;
}

.container {
  padding: 40rpx;
}

.welcome-section {
  margin-bottom: 60rpx;
}

.greeting {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.feature-item {
  background-color: var(--bg-secondary);
  padding: 40rpx 30rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-color);
  transition: all 0.3s ease;
  animation-fill-mode: both;
}

.feature-item:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-md);
}

.icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  transition: transform 0.3s ease;
}

.icon-wrapper.hover-lift:active {
  transform: translateY(-4rpx);
}

.ai-bg { background-color: #e6f7ff; }
.word-bg { background-color: #f6ffed; }
.disk-bg { background-color: #fff7e6; }
.article-bg { background-color: #f0f5ff; }
.user-bg { background-color: #f9f0ff; }

.feature-icon {
  width: 60rpx;
  height: 60rpx;
}

.feature-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.stats-section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  display: block;
  margin-bottom: 30rpx;
}

.stats-card {
  background-color: var(--bg-secondary);
  border-radius: 30rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
