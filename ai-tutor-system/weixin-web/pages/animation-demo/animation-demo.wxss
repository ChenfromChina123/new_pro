/** 动画演示页面样式 **/

.min-h-screen {
  min-height: 100vh;
}

.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-md);
}

.container {
  padding: 32rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.animation-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.animation-item {
  background-color: var(--bg-secondary);
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  box-shadow: var(--shadow-sm);
  animation-fill-mode: both;
}

.animation-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 骨架屏卡片 */
.card {
  background-color: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-color);
}

/* 按钮组 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn {
  padding: 24rpx 48rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--gradient-primary);
  color: #ffffff;
  box-shadow: var(--shadow-sm);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:active {
  background-color: var(--bg-tertiary);
  border-color: var(--gray-300);
}

/* 点击反馈 */
.clickable:active {
  opacity: 0.7;
  transform: scale(0.95);
}

/* 打字机演示 */
.typing-demo {
  background-color: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--border-color);
}

.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 40rpx;
  background-color: var(--primary-color);
  margin-left: 8rpx;
  animation: blink-cursor 1s step-end infinite;
}

@keyframes blink-cursor {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

/* 深色模式适配 */
page.dark-mode .animation-item {
  border-color: var(--gray-600);
}

page.dark-mode .section-title {
  border-bottom-color: var(--gray-700);
}
