/* 主题变量 - 日间模式 */
page {
  /* 企业级主色调 - 深蓝色系 */
  --primary-color: #1d4ed8;
  --primary-rgb: 29, 78, 216;
  --primary-dark: #1e40af;
  --primary-light: #3b82f6;
  --secondary-color: #64748b;
  --accent-color: #f59e0b;
  
  /* 功能色 */
  --success-color: #10b981;
  --warning-color: #f59e0b;
  --danger-color: #ef4444;
  --info-color: #3b82f6;
  
  /* 灰色系 */
  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;
  
  /* 背景和文本颜色 */
  --bg-primary: #f9fafb;
  --bg-secondary: #ffffff;
  --bg-tertiary: #f3f4f6;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --text-tertiary: #9ca3af;
  
  /* 边框和阴影 */
  --border-color: #e5e7eb;
  --border-radius-sm: 12rpx;
  --border-radius-md: 16rpx;
  --border-radius-lg: 24rpx;
  --shadow-sm: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.1), 0 4rpx 8rpx -2rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 20rpx 30rpx -6rpx rgba(0, 0, 0, 0.1), 0 8rpx 12rpx -4rpx rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 40rpx 50rpx -10rpx rgba(0, 0, 0, 0.1), 0 20rpx 20rpx -10rpx rgba(0, 0, 0, 0.04);
  
  /* 渐变 */
  --gradient-primary: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
  --gradient-secondary: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);
  
  /* 聊天相关 */
  --chat-bg: #f9fafb;
  --ai-message-bg: #f3f4f6;
  --user-message-bg: #1d4ed8;
  
  /* 特殊元素 */
  --input-bg: #ffffff;
  --card-border: rgba(0, 0, 0, 0.08);
  --chip-bg: rgba(59, 130, 246, 0.12);
  --chip-color: #1d4ed8;
  --icon-btn-bg: rgba(0, 0, 0, 0.06);
  --toolbar-btn-bg: rgba(59, 130, 246, 0.08);
  --toolbar-btn-border: rgba(59, 130, 246, 0.2);
  
  /* 背景渐变色 */
  --gradient-start: #f0f9ff;
  --gradient-end: #e0f2fe;
  
  /* 状态颜色 */
  --bg-error: #fef2f2;
  --border-error: #fee2e2;
  --text-error: #991b1b;
  --bg-success: #f0fdf4;
  --border-success: #dcfce7;
  --text-success: #166534;
  --bg-warning: #fffbeb;
  --border-warning: #fef3c7;
  --text-warning: #92400e;
  --bg-info: #eff6ff;
  --border-info: #dbeafe;
  --text-info: #1e40af;
}

/* 夜间模式变量 */
page.dark-mode {
  /* 背景和文本颜色 */
  --bg-primary: #111827;
  --bg-secondary: #1f2937;
  --bg-tertiary: #374151;
  --text-primary: #f9fafb;
  --text-secondary: #d1d5db;
  --text-tertiary: #9ca3af;
  
  /* 边框和阴影 */
  --border-color: #374151;
  --shadow-sm: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.3);
  --shadow-md: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.4), 0 4rpx 8rpx -2rpx rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 20rpx 30rpx -6rpx rgba(0, 0, 0, 0.5), 0 8rpx 12rpx -4rpx rgba(0, 0, 0, 0.4);
  --shadow-xl: 0 40rpx 50rpx -10rpx rgba(0, 0, 0, 0.6), 0 20rpx 20rpx -10rpx rgba(0, 0, 0, 0.5);
  
  /* 聊天相关 */
  --chat-bg: #1f2937;
  --ai-message-bg: #374151;
  --user-message-bg: #1d4ed8;
  
  /* 状态颜色背景 */
  --bg-error: #450a0a;
  --border-error: #7f1d1d;
  --text-error: #fca5a5;
  --bg-success: #052e16;
  --border-success: #14532d;
  --text-success: #86efac;
  --bg-warning: #451a03;
  --border-warning: #78350f;
  --text-warning: #fcd34d;
  --bg-info: #0c1a3a;
  --border-info: #1e3a8a;
  --text-info: #93c5fd;
  
  /* 特殊元素 */
  --input-bg: #1f2937;
  --card-border: rgba(255, 255, 255, 0.1);
  --chip-bg: rgba(59, 130, 246, 0.2);
  --chip-color: #93c5fd;
  --icon-btn-bg: rgba(255, 255, 255, 0.1);
  --toolbar-btn-bg: rgba(59, 130, 246, 0.1);
  --toolbar-btn-border: rgba(59, 130, 246, 0.35);
  
  /* 背景渐变色 */
  --gradient-start: #0f172a;
  --gradient-end: #1e293b;
}

/* 全局背景色 */
.page-bg {
  background-color: var(--bg-primary);
}

/* 深色模式背景 */
page.dark-mode .page-bg {
  background-color: var(--bg-primary);
}
