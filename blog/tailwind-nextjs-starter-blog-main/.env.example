# Giscus 评论系统配置
# 访问 https://giscus.app/zh-CN 生成你的配置

# 仓库信息
NEXT_PUBLIC_GISCUS_REPO=ChenfromChina123/new_pro
NEXT_PUBLIC_GISCUS_REPO_ID=你的仓库 ID（从 giscus.app 获取）
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=你的分类 ID（从 giscus.app 获取）
DECAP_GITHUB_CLIENT_ID=你的 GitHub OAuth App Client ID
DECAP_GITHUB_CLIENT_SECRET=你的 GitHub OAuth App Client Secret
DECAP_PUBLIC_ORIGIN=https://blog.aistudy.icu
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=请设置高强度密码
BLOG_ADMIN_SESSION_SECRET=请设置随机长字符串作为会话签名密钥

# 获取步骤：
# 1. 访问 https://giscus.app/zh-CN
# 2. 输入你的 GitHub 仓库：ChenfromChina123/new_pro
# 3. 点击 "Announcements" 或 "General" 分类
# 4. 复制 repositoryId 和 categoryId
# 5. 将这些值填入上面的环境变量
