{
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.validate.enable": false,
  "vue.validate.enable": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "vue",
    "typescript",
    "typescriptreact"
  ],
  "diagnostics.ignore": [
    "modules-not-found",
    "missing-types"
  ]
}
